# ===========================================
# UniSearch 环境变量配置文件
# ===========================================
# 
# 【重要安全提示】
# ⚠️  本文件仅作为配置模板，切勿直接用于生产环境！
# ⚠️  所有标记为 [必须修改] 的配置项必须在生产环境中更改
# ⚠️  建议使用密钥管理服务（如 Vault、AWS Secrets Manager）管理敏感信息
#
# 【使用说明】
# 1. 本地开发环境：
#    - 复制此文件为 .env
#    - DB_HOST 设置为 localhost
#    - 启动脚本 scripts/local.sh 会自动加载 .env 文件
#
# 2. Docker Compose 环境：
#    - 复制此文件为 .env
#    - DB_HOST 设置为 mysql（服务名）
#    - docker-compose.yml 会自动加载 .env 文件
#
# 3. 生产环境部署：
#    - 参考"运维部署配置"章节
#    - 使用命令生成强随机密钥：openssl rand -base64 32
#    - 建议使用环境变量注入而非 .env 文件
#
# ===========================================
# 基础业务配置
# ===========================================
TZ=Asia/Shanghai

# 应用监听端口 [可选修改]
# 建议生产环境使用反向代理，应用监听非标准端口
PORT=8888

# ===========================================
# 数据库配置 (MySQL) - 必需配置
# ===========================================
# 数据库主机地址 [必须修改]
# - Docker Compose 环境: mysql
# - 本地开发环境: localhost
# - 生产环境: 实际数据库地址（建议使用内网地址）
DB_HOST=localhost

# 数据库端口 [可选修改]
# 生产环境建议修改为非标准端口
DB_PORT=3306

# 数据库用户名 [必须修改]
# 生产环境禁止使用 root 用户，应创建专用数据库用户
DB_USER=unisearch_app

# 数据库密码 [必须修改]
# 要求：至少 16 字符，包含大小写字母、数字和特殊字符
# 生成方式: openssl rand -base64 24
DB_PASSWORD=PLEASE_CHANGE_THIS_PASSWORD

# 数据库名称 [可选修改]
# 系统启动时会自动创建
DB_NAME=unisearch

# ===========================================
# 认证与安全配置 [生产环境必须修改]
# ===========================================
# 运行环境 [生产环境必须设置为 production]
# 可选值: development, test, production
APP_ENV=development

# CORS 允许来源 [生产环境必须修改]
# 多个来源用英文逗号分隔；生产环境禁止使用 *
# 注意：刷新令牌走 httpOnly cookie（携带 credentials），后端仅对具体白名单来源
# 返回 Access-Control-Allow-Credentials；通配 * 无法与 credentials 共用，务必配置精确域名。
ALLOWED_ORIGINS=https://example.com

# 首次初始化管理员 [生产环境必须修改]
# 生产环境不会自动创建 admin/admin，必须显式提供初始管理员账号和强密码
INITIAL_ADMIN_USERNAME=PLEASE_SET_INITIAL_ADMIN_USERNAME
INITIAL_ADMIN_PASSWORD=PLEASE_SET_INITIAL_ADMIN_STRONG_PASSWORD

# 是否启用 API Key 认证 [推荐启用]
API_KEY_ENABLED=true

# ===========================================
# 注册防刷 / 反恶意注册配置
# ===========================================
# 说明：治理恶意批量注册的多层防护。所有项均可关闭或调大阈值以快速止血。
# 详细方案见 docs/design_register_anti_abuse.md。

# 可信反向代理网段（CIDR 或 IP，逗号分隔）[生产环境按拓扑设置]
# 用途：保证 c.ClientIP() 取到真实客户端 IP，而非反代 IP，是 IP 限流/封禁生效且不误伤的前提。
# ⚠️  配置错误（如信任了公网或留空但反代不在回环）会导致所有请求解析成同一 IP，
#     进而"一封全站"或被伪造 X-Forwarded-For 绕过。
# - 留空：默认仅信任回环地址 127.0.0.1 与 ::1（适用于 Nginx 与后端同机、反代自 127.0.0.1 的部署）
# - 反代在其它主机：填反代的内网 IP/网段，如 10.0.0.0/8 或 172.18.0.1
#TRUSTED_PROXIES=

# 注册 IP 维度限流阈值 [可选修改]
# 同一 IP（不含用户名）在窗口内的注册请求上限，任一超限即拒绝（修复"同 IP 换用户名绕过"漏洞）。
# NAT/校园网等共享出口场景可适当调大，上线后按监控调优。
SIGNUP_IP_LIMIT_PER_MIN=5
SIGNUP_IP_LIMIT_PER_HOUR=20

# 注册限流 / 自动封禁计数是否使用 Redis 后端 [可选修改]
# - true（默认）：计数落 Redis，多实例共享、进程重启不丢；Redis 不可用时运行期自动降级到内存并告警。
# - false：使用纯内存计数（单实例部署可用，多实例下各实例独立计数）。
SIGNUP_RATE_LIMIT_USE_REDIS=true

# 全站注册熔断阈值（每小时注册成功总量上限）[可选修改]
# 用途：应对分布式代理池刷号。全站单位时间注册成功数超过该值即进入熔断态，暂停新注册。
# - 0（默认）：关闭熔断。启用请按业务真实峰值设置，避免误伤正常高峰。
SIGNUP_GLOBAL_LIMIT_PER_HOUR=0

# 触发全局熔断后暂停新注册的持续时长（分钟）[可选修改]
# 仅在 SIGNUP_GLOBAL_LIMIT_PER_HOUR>0 时生效，到时自动恢复。
SIGNUP_CIRCUIT_BREAK_MIN=10

# 登录 IP 维度限流阈值 [可选修改]
# 同一 IP（不含用户名）在窗口内的登录请求上限，任一超限即拒绝（防止换用户名撞库绕过限流）。
# 登录比注册频次更高，默认放宽；NAT/校园网等共享出口场景可再调大。
LOGIN_IP_LIMIT_PER_MIN=10
LOGIN_IP_LIMIT_PER_HOUR=100

# 登录限流 / 账户锁定计数是否使用 Redis 后端 [可选修改]
# - true（默认）：计数落 Redis，多实例共享、进程重启不丢；Redis 不可用时运行期自动降级到内存并告警。
# - false：使用纯内存计数（单实例部署可用，多实例下各实例独立计数）。
LOGIN_RATE_LIMIT_USE_REDIS=true

# 账户级登录失败锁定 [可选修改]
# 同一账户连续登录失败达到阈值即锁定一段时间（针对单一账户的在线爆破防护，登录成功清零计数）。
# - LOGIN_ACCOUNT_LOCK_THRESHOLD=0 关闭锁定；>0 为触发锁定的连续失败次数。
LOGIN_ACCOUNT_LOCK_THRESHOLD=5
# 账户锁定持续时长（分钟）
LOGIN_ACCOUNT_LOCK_MIN=15

# 用户名查重 IP 维度限流阈值 [可选修改]
# 注册页实时查重接口（/api/auth/check-username）的单 IP 请求上限，任一超限即拒绝。
# 仅以 ClientIP 为 key（不含用户名），堵住"单 IP 遍历大量用户名"的账号枚举。
# 与登录限流共用后端（LOGIN_RATE_LIMIT_USE_REDIS 决定内存或 Redis）。
# 该接口是页面输入即触发的高频接口，默认放宽；NAT/校园网等共享出口可再调大。
CHECK_USERNAME_IP_LIMIT_PER_MIN=3
CHECK_USERNAME_IP_LIMIT_PER_HOUR=200

# 注册人机验证（Cloudflare Turnstile）[可选启用]
# 说明：验证码开关存于后台"系统设置 -> 账号与访问"，默认关闭，可灰度开启。
# 这里仅配置密钥；开关打开但密钥缺失时，后端会因验证配置错误拒绝注册。
# 获取位置：Cloudflare 控制台 -> Turnstile -> 添加站点。
# - TURNSTILE_SITE_KEY：前端组件用的站点公钥，会经公开系统设置接口返回给前端。
# - TURNSTILE_SECRET_KEY：服务端向 Cloudflare 校验用的密钥，切勿泄露。
#TURNSTILE_SITE_KEY=
#TURNSTILE_SECRET_KEY=

# 提示：IP 自动封禁（触发窗口/阈值/时长/开关）不在此配置，
# 已收敛到后台"系统设置 -> 账号与访问"，支持热调、无需重启。

# ===========================================
# 密钥管理配置
# ===========================================
# 密钥存储后端类型 [可选修改]
# 可选值: database（数据库存储，默认推荐）, environment（环境变量）
# 默认: database
# - database: 密钥加密存储在数据库中，支持密钥轮换和版本管理（推荐生产环境）
# - environment: 从环境变量读取密钥（向后兼容，适合简单部署）
SECRET_BACKEND=database

# 主密钥（用于加密数据库中的密钥）[必须修改]
# 在 SECRET_BACKEND=database 时必需
# 要求：至少 32 字节的强随机字符串
# 生成方式: openssl rand -base64 32
# ⚠️  主密钥泄露将导致所有存储的密钥可被解密
# 注意：主密钥本身不存储在数据库中，只存储在环境变量中
SECRET_MASTER_KEY=PLEASE_GENERATE_A_STRONG_MASTER_KEY_HERE

# JWT 签名密钥 [必须修改]
# 要求：至少 32 字节的强随机字符串
# 生成方式: openssl rand -base64 32
# ⚠️  密钥泄露将导致所有 Token 可被伪造
# 注意：
# - environment 模式：直接使用此环境变量
# - database 模式：首次启动时会自动迁移到数据库，之后从数据库读取
AUTH_JWT_SECRET=PLEASE_GENERATE_A_STRONG_RANDOM_SECRET_KEY_HERE

# 公开资源 ID 派生密钥 [必须修改]
# 用于生成不可反推来源的资源详情 URL 标识，必须与 JWT 等认证密钥完全不同。
# 要求：至少 32 字节的强随机字符串；轮换后旧资源详情 URL 会失效。
# 生成方式: openssl rand -base64 32
RESOURCE_PUBLIC_ID_SECRET=PLEASE_GENERATE_A_STRONG_RESOURCE_PUBLIC_ID_SECRET_HERE

# JWT Token 有效期（小时）[可选修改]
# 建议值：1-24 小时，根据安全需求调整
AUTH_TOKEN_EXPIRY=24

# 用户名与密码长度策略 [可选修改]
# 前端注册页会读取公开系统设置中的这组策略，后端仍然是最终校验来源
# 新设置的账号密码不能包含空格、Tab、换行等空白字符
AUTH_USERNAME_MIN_LENGTH=3
AUTH_USERNAME_MAX_LENGTH=32
AUTH_PASSWORD_MIN_LENGTH=6
AUTH_PASSWORD_MAX_LENGTH=64
# 密码复杂度：大写字母/小写字母/数字/符号 中至少满足几类（1-4，默认 3）
AUTH_PASSWORD_COMPLEXITY_CLASSES=3
# 弱密码黑名单文件路径（可选，每行一个弱口令，用于扩展内置黑名单）
AUTH_PASSWORD_BLOCKLIST_PATH=

# 是否启用刷新令牌（记住密码功能）[可选修改]
REFRESH_TOKEN_ENABLED=true

# 刷新令牌存储类型 [可选修改]
# 可选值: database（数据库存储，推荐）, file（文件存储）
# 默认: database
# - database: 存储在 MySQL 数据库中，支持分布式部署，性能更好
# - file: 存储在加密文件中，适合单机部署
REFRESH_TOKEN_STORAGE=database

# 刷新令牌有效期（小时）[可选修改]
# 默认 720 小时（30 天），建议不超过 90 天
REFRESH_TOKEN_TTL=720

# 刷新令牌存储路径 [可选修改]
# 仅在 REFRESH_TOKEN_STORAGE=file 时使用
# Docker 环境使用绝对路径，本地开发可使用相对路径
REFRESH_TOKEN_STORE_PATH=./cache/refresh_tokens.dat

# 刷新令牌加密密钥 [必须修改]
# 要求：必须是 32 字节（44 个 base64 字符）
# 生成方式: openssl rand -base64 32
# ⚠️  密钥泄露将导致所有刷新令牌可被解密
# 注意：database 模式下此密钥用于客户端传输加密，file 模式下用于文件加密
REFRESH_TOKEN_ENCRYPT_KEY=PLEASE_GENERATE_A_32_BYTE_ENCRYPTION_KEY

# ===========================================
# Redis 缓存配置
# ===========================================
# ⚠️  多副本 / 多实例部署必须启用 Redis：
#   以下安全能力在 Redis 不可用时会各自降级为「单实例进程内存」，多副本下会失效或不一致：
#   - Access Token 吊销名单（登出即时失效）：在 A 实例登出的 token 到 B 实例仍有效
#   - 账户级登录失败锁定 / 登录·注册限流计数：各副本独立计数，等于阈值被放大 N 倍
#   - 注册自动封禁 / 全局熔断：无法跨副本共享状态
#   单实例部署可不配 Redis（自动降级内存，功能可用）；多副本务必配置以保证上述防护生效。
# Redis 主机地址 [可选修改]
# - Docker Compose 环境: redis（服务名）
# - 本地开发环境: localhost
# - 生产环境: 实际 Redis 地址（建议使用内网地址）
REDIS_HOST=redis

# Redis 端口 [可选修改]
# 默认 6379，生产环境建议修改为非标准端口
REDIS_PORT=6379

# Redis 密码 [生产环境必须修改]
# 本地开发如使用无密码 Redis，可复制后自行置空；生产环境必须设置强密码
# 生成方式: openssl rand -base64 24
REDIS_PASSWORD=PLEASE_SET_STRONG_REDIS_PASSWORD

# Redis 数据库编号 [可选修改]
# 默认使用 DB 0，可选值 0-15
REDIS_DB=0

# Redis 缓存过期时间（秒）[可选修改]
# 默认 3600 秒（1 小时）
# 根据业务需求调整，建议 1800-7200 秒
# 说明：该值现在主要用于首次初始化后台缓存配置时写入默认搜索缓存 TTL
REDIS_TTL=3600

# ===========================================
# TMDB 热门内容页配置
# ===========================================
# 正常推荐配置：TMDB Read Access Token（推荐）
# 获取位置：TMDB -> Settings -> API -> API Read Access Token
# 说明：/hot 页面正常使用时优先配置该字段，并将 TMDB_API_KEY 留空
TMDB_READ_ACCESS_TOKEN=

# 兼容配置：TMDB API Key（v3，可选）
# 获取位置：TMDB -> Settings -> API -> API Key
# 说明：如果没有 Read Access Token，可以只配置这个字段
# 如果已经配置了 TMDB_READ_ACCESS_TOKEN，建议将这里留空，避免混淆
TMDB_API_KEY=

# TMDB API 基础地址
TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB 默认语言与区域
TMDB_DEFAULT_LANGUAGE=zh-CN
TMDB_DEFAULT_REGION=CN

# TMDB 图片基础地址
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# TMDB 请求超时时间
TMDB_REQUEST_TIMEOUT=8s

# 热门榜单预热配置
# 启动后会先预热一次，随后每天按北京时间固定时刻刷新到 Redis
# 说明：这些值在首次初始化后台缓存配置时会写入 `system_settings`
# 后续推荐直接在后台“系统设置 -> 缓存配置”中调整
HOT_RANKING_PRELOAD_ENABLED=true
HOT_RANKING_PRELOAD_TIME=00:00
HOT_RANKING_PRELOAD_TIMEOUT=30s
HOT_RANKING_PRELOAD_CONCURRENCY=2

# 热门榜单缓存 TTL
# 说明：后台统一使用 24 小时 TTL，这里主要作为首次初始化默认值来源
HOT_RANKING_CACHE_TTL_DAY=24h
HOT_RANKING_CACHE_TTL_WEEK=24h
HOT_RANKING_CACHE_TTL_MONTH=24h
HOT_RANKING_CACHE_TTL_YEAR=24h

# ===========================================
# 异步插件配置
# ===========================================
# 是否启用异步插件 [推荐启用]
ASYNC_PLUGIN_ENABLED=true

# 异步响应超时时间（秒）[可选修改]
ASYNC_RESPONSE_TIMEOUT=4

# 后台工作线程数 [可选修改]
# 建议值：CPU 核心数 * 2，避免过高导致资源耗尽
ASYNC_MAX_BACKGROUND_WORKERS=20

# 后台任务队列最大长度 [可选修改]
ASYNC_MAX_BACKGROUND_TASKS=100

# 异步缓存过期时间（小时）[可选修改]
ASYNC_CACHE_TTL_HOURS=1

# 是否启用异步日志 [可选修改]
ASYNC_LOG_ENABLED=true

# ===========================================
# 插件配置
# ===========================================
# 插件请求超时时间（秒）[可选修改]
PLUGIN_TIMEOUT=30

# 初始化 Telegram 频道兜底列表 [可选修改]
# 用途：
# 1. 首次启动时补齐数据库中缺失的频道
# 2. 数据库暂无启用频道时，作为搜索默认频道兜底
CHANNELS=seedhub_pro,WidgetChannel,SharePanBaidu,tianyifc,yunpanxunlei,BaiduCloudDisk,shareAliyun,Aliyun_4K_Movies,ali_yppan,bdbdndn11,yunpanx,yp123pan,bsbdbfjfjff,txtyzy,peccxinpd,gotopan,PanjClub,baicaoZY,MCPH01,MCPH02,MCPH03,bdwpzhpd,ysxb48,jdjdn1111,MCPH086,zaihuayun,Q66Share,ucwpzy,Quark_Movies,XiangxiuNBB,ydypzyfx,ucquark,xx123pan,yingshifenxiang123,zyfb123,tyypzhpd,tianyirigeng,cloudtianyi,hdhhd21,Lsp115,oneonefivewpfx,taoxgzy,Channel_Shares_115,vip115hot,wp123zy,yunpan139,yunpan189,yunpanuc,yydf_hzl,leoziyuan,Q_dongman,yoyokuakeduanju,TG654TG,QukanMovie,yeqingjie_GJG666,movielover8888_film3,Baidu_netdisk,D_wusun,FLMdongtianfudi,QQZYDAPP,rjyxfx,PikPak_Share_Channel,btzhi,newproductsourcing,duan_ju,QuarkFree,yunpanNB,kkdj001,xxzlzn,pxyunpanxunlei,jxwpzy,kuakedongman,xiangnikanj,solidsexydoll,guoman4K,zdqxm,kduanju,cilidianying,CBduanju,SharePanFilms,dzsgx,BooksRealm,Oscar_4Kmovies,douerpan,baidu_yppan,Q_jilupian,Netdisk_Movies,yunpanquark,ciliziyuanku,tgbokee,gokuapan,gimy115,WFYSFX03,Q_dianying,domgmingapk,dianying4k,q_dianshiju,ucshare,godupan,gimy100,gimy115iso

# 启动注册默认插件清单 [可选修改]
# 用途：
# 1. 限制启动时注册哪些源码内置插件
# 2. 作为默认清单和临时覆盖项，长期启停状态仍以后台/数据库为准
ENABLED_PLUGINS=labi,shandian,muou,hunhepan,pansearch,susu,thepiratebay,u3c3,jutoushe,nyaa,aikanzy,quark4k,quarksoo,huban,panwiki,sidhub

# ===========================================
# HTTP 服务器配置
# ===========================================
# 读取超时时间（秒）[可选修改]
HTTP_READ_TIMEOUT=90

# 写入超时时间（秒）[可选修改]
HTTP_WRITE_TIMEOUT=90

# 空闲超时时间（秒）[可选修改]
HTTP_IDLE_TIMEOUT=120

# 最大并发连接数 [可选修改]
# 建议值：500-2000，根据服务器性能调整
# ⚠️  过高可能导致资源耗尽，建议配合限流使用
HTTP_MAX_CONNS=2000

# ===========================================
# 性能优化配置
# ===========================================
# Go GC 触发百分比 [可选修改]
# 默认 100，增大可减少 GC 频率但增加内存占用
GC_PERCENT=100

# 是否启用内存优化 [推荐启用]
OPTIMIZE_MEMORY=true

# 是否启用响应压缩 [可选修改]
# 启用后可减少带宽消耗，但增加 CPU 负载
ENABLE_COMPRESSION=false

# 压缩最小文件大小（字节）[可选修改]
MIN_SIZE_TO_COMPRESS=1024

# 并发搜索数 [可选修改]
# 建议值：20-100，根据插件数量和服务器性能调整
CONCURRENCY=50

# ===========================================
# 搜索链路调优 [可选，默认值已适用，取消注释以覆盖]
# ===========================================
# 插件状态缓存 TTL（秒），默认 30
#PLUGIN_STATE_CACHE_TTL_SECONDS=30
# 搜索缓存异步写队列长度，默认 256
#CACHE_WRITE_QUEUE_SIZE=256
# 搜索缓存异步写 worker 数，默认 4
#CACHE_WRITE_WORKERS=4
# 常态搜索事件日志（排障时临时开启），默认 false
#SEARCH_EVENT_LOG_ENABLED=false

# ===========================================
# 网络代理 [可选]
# ===========================================
# 统一代理（设置后自动启用），如 socks5://127.0.0.1:1080 或 http://127.0.0.1:7890
#PROXY=
# 或分别设置 HTTP/HTTPS 代理
#HTTP_PROXY=
#HTTPS_PROXY=

# ===========================================
# 前端公开配置 [可选]
# ===========================================
VITE_PUBLIC_SITE_URL=https://example.com/
VITE_DEFAULT_COPY_FORMAT_TEMPLATE=卡密：{key}，网址：https://example.com/

# ===========================================
# 运维脚本专用配置
# ===========================================
# 与 build.sh / deploy-update.sh / backup-manager.sh / gen-production-secrets.sh
# 相关的部署变量已迁移到 `deploy/.env.operations.example`。

# ===========================================
# 配置验证检查清单
# ===========================================
# 如果本地或测试环境曾经使用过模板中的占位密钥、默认数据库凭据或 TMDB token，
# 上线前必须重新生成并轮换，避免把已暴露配置带入生产环境。
# 部署前请确认以下配置项已修改：
# [ ] DB_PASSWORD - 数据库密码
# [ ] ALLOWED_ORIGINS - 生产前端和管理端域名
# [ ] AUTH_JWT_SECRET - JWT 签名密钥
# [ ] RESOURCE_PUBLIC_ID_SECRET - 公开资源 ID 派生密钥
# [ ] SECRET_MASTER_KEY - 主密钥（database 模式必需）
# [ ] REFRESH_TOKEN_ENCRYPT_KEY - 刷新令牌加密密钥（32字节）
# [ ] REDIS_PASSWORD - Redis 密码（生产环境必需）
#
# 可选但推荐修改：
# [ ] DB_USER - 使用专用数据库用户而非 root
# [ ] DB_PORT - 修改为非标准端口
# [ ] SECRET_BACKEND - 选择密钥存储后端（推荐 database）
# [ ] REDIS_HOST - Redis 主机地址
# [ ] REDIS_PORT - Redis 端口（生产环境建议修改）
#
# 注册防刷相关（反恶意注册）：
# [ ] TRUSTED_PROXIES - 按反代拓扑确认（反代非本机时必须设置，否则 IP 限流/封禁失效或误伤）
# [ ] SIGNUP_GLOBAL_LIMIT_PER_HOUR - 如需全局熔断，按业务峰值设置（默认 0=关闭）
# [ ] TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY - 如需开启注册人机验证则配置
