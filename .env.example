# ===========================================
# UniSearch 环境变量配置文件
# ===========================================
# 
# 【使用说明】
# 1. 本地开发环境：
#    - 复制此文件为 .env
#    - DB_HOST 设置为 localhost
#    - 启动脚本 scripts/local.sh 会自动加载 .env 文件
#
# 2. Docker Compose 环境：
#    - 复制此文件为 .env
#    - DB_HOST 设置为 mysql（服务名）
#    - docker-compose.yml 会自动加载 .env 文件
#
# 3. 生产环境部署：
#    - 参考"运维部署配置"章节
#    - 必须修改所有标记为"生产环境必须修改"的配置项
#
# ===========================================
# 基础业务配置
# ===========================================
TZ=Asia/Shanghai
PORT=8888

# ===========================================
# 数据库配置 (MySQL) - 必需配置
# ===========================================
# 数据库主机地址
# - Docker Compose 环境: mysql
# - 本地开发环境: localhost
# - 生产环境: 实际数据库地址
DB_HOST=localhost

# 数据库端口（MySQL 默认 3306）
DB_PORT=3306

# 数据库用户名
DB_USER=root

# 数据库密码（生产环境必须修改）
DB_PASSWORD=root

# 数据库名称（必需，系统启动时会自动创建）
DB_NAME=unisearch

# ===========================================
# 认证配置
# ===========================================
# 是否启用 API Key 认证
API_KEY_ENABLED=true

# JWT 配置
# JWT 签名密钥（生产环境必须修改为强随机密钥）
# 生成方式: openssl rand -base64 32
AUTH_JWT_SECRET=change-this-to-random-secret-key-in-production

# JWT Token 有效期（小时），默认 24 小时
AUTH_TOKEN_EXPIRY=24

# ===========================================
# 刷新令牌配置（记住密码功能）
# ===========================================
# 是否启用刷新令牌
REFRESH_TOKEN_ENABLED=true

# 刷新令牌有效期（小时），默认 720 小时（30 天）
REFRESH_TOKEN_TTL=720

# 刷新令牌存储路径
REFRESH_TOKEN_STORE_PATH=./cache/refresh_tokens.dat

# 刷新令牌加密密钥（32字节，生产环境必须修改）
# 生成方式: openssl rand -base64 32
REFRESH_TOKEN_ENCRYPT_KEY=change-this-to-32-byte-secret-in-production

# ===========================================
# 缓存配置
# ===========================================
CACHE_ENABLED=true
CACHE_PATH=/app/cache
CACHE_MAX_SIZE=100
CACHE_TTL=60

# ===========================================
# 异步插件配置
# ===========================================
ASYNC_PLUGIN_ENABLED=true
ASYNC_RESPONSE_TIMEOUT=4
ASYNC_MAX_BACKGROUND_WORKERS=20
ASYNC_MAX_BACKGROUND_TASKS=100
ASYNC_CACHE_TTL_HOURS=1
ASYNC_LOG_ENABLED=true

# ===========================================
# 插件配置
# ===========================================
PLUGIN_TIMEOUT=30
CHANNELS=tgsearchers3,SharePanBaidu,yunpanxunlei,tianyifc,BaiduCloudDisk
# 启用的插件列表
ENABLED_PLUGINS=labi,zhizhen,shandian,duoduo,muou,ouge,huban,cyg,fox4k,hdr4k,hunhepan,jikepan,pan666,panta,panyq,qupansou,susu,thepiratebay,wanou,xuexizhinan
PLUGIN_COUNT=21

# ===========================================
# HTTP服务器配置
# ===========================================
HTTP_READ_TIMEOUT=90
HTTP_WRITE_TIMEOUT=90
HTTP_IDLE_TIMEOUT=120
HTTP_MAX_CONNS=2000

# ===========================================
# 性能优化配置
# ===========================================
GC_PERCENT=100
OPTIMIZE_MEMORY=true
ENABLE_COMPRESSION=false
MIN_SIZE_TO_COMPRESS=1024
CONCURRENCY=50

# ===========================================
# 运维部署配置 (生产环境专用)
# ===========================================

# 域名配置
DOMAIN=example.com
WWW_DOMAIN=www.example.com

# Docker镜像配置
DOCKER_USERNAME=your_username
IMAGE_NAME=unisearch
VERSION=1.0.0
FULL_IMAGE_NAME=your_username/unisearch:1.0.0

# Nginx端口
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
FRONTEND_PORT=3000
BACKEND_PORT=8888

# SSL证书配置
SSL_CERT_PATH=/etc/letsencrypt/live/${DOMAIN}/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/${DOMAIN}/privkey.pem
SSL_EMAIL=admin@example.com

# 监控与日志
ENABLE_MONITORING=true
ENABLE_LOG_COLLECTION=true
WATCHTOWER_TOKEN=your-update-token

# 备份配置
BACKUP_PATH=/opt/unisearch/backup
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"

# 防火墙
UFW_ENABLED=true
UFW_ALLOW_PORTS=22,80,443

# 部署元数据
DEPLOY_ENV=production
DEPLOY_VERSION=1.0.0
