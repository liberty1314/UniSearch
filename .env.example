# ===========================================
# UniSearch 环境变量配置文件
# ===========================================
# 
# 【重要安全提示】
# ⚠️  本文件仅作为配置模板，切勿直接用于生产环境！
# ⚠️  所有标记为 [必须修改] 的配置项必须在生产环境中更改
# ⚠️  建议使用密钥管理服务（如 Vault、AWS Secrets Manager）管理敏感信息
#
# 【使用说明】
# 1. 本地开发环境：
#    - 复制此文件为 .env
#    - DB_HOST 设置为 localhost
#    - 启动脚本 scripts/local.sh 会自动加载 .env 文件
#
# 2. Docker Compose 环境：
#    - 复制此文件为 .env
#    - DB_HOST 设置为 mysql（服务名）
#    - docker-compose.yml 会自动加载 .env 文件
#
# 3. 生产环境部署：
#    - 参考"运维部署配置"章节
#    - 使用命令生成强随机密钥：openssl rand -base64 32
#    - 建议使用环境变量注入而非 .env 文件
#
# ===========================================
# 基础业务配置
# ===========================================
TZ=Asia/Shanghai

# 应用监听端口 [可选修改]
# 建议生产环境使用反向代理，应用监听非标准端口
PORT=8888

# ===========================================
# 数据库配置 (MySQL) - 必需配置
# ===========================================
# 数据库主机地址 [必须修改]
# - Docker Compose 环境: mysql
# - 本地开发环境: localhost
# - 生产环境: 实际数据库地址（建议使用内网地址）
DB_HOST=localhost

# 数据库端口 [可选修改]
# 生产环境建议修改为非标准端口
DB_PORT=3306

# 数据库用户名 [必须修改]
# 生产环境禁止使用 root 用户，应创建专用数据库用户
DB_USER=root

# 数据库密码 [必须修改]
# 要求：至少 16 字符，包含大小写字母、数字和特殊字符
# 生成方式: openssl rand -base64 24
DB_PASSWORD=PLEASE_CHANGE_THIS_PASSWORD

# 数据库名称 [可选修改]
# 系统启动时会自动创建
DB_NAME=unisearch

# ===========================================
# 认证与安全配置 [生产环境必须修改]
# ===========================================
# 是否启用 API Key 认证 [推荐启用]
API_KEY_ENABLED=true

# ===========================================
# 密钥管理配置
# ===========================================
# 密钥存储后端类型 [可选修改]
# 可选值: database（数据库存储，默认推荐）, environment（环境变量）
# 默认: database
# - database: 密钥加密存储在数据库中，支持密钥轮换和版本管理（推荐生产环境）
# - environment: 从环境变量读取密钥（向后兼容，适合简单部署）
SECRET_BACKEND=database

# 主密钥（用于加密数据库中的密钥）[必须修改]
# 在 SECRET_BACKEND=database 时必需
# 要求：至少 32 字节的强随机字符串
# 生成方式: openssl rand -base64 32
# ⚠️  主密钥泄露将导致所有存储的密钥可被解密
# 注意：主密钥本身不存储在数据库中，只存储在环境变量中
SECRET_MASTER_KEY=PLEASE_GENERATE_A_STRONG_MASTER_KEY_HERE

# JWT 签名密钥 [必须修改]
# 要求：至少 32 字节的强随机字符串
# 生成方式: openssl rand -base64 32
# ⚠️  密钥泄露将导致所有 Token 可被伪造
# 注意：
# - environment 模式：直接使用此环境变量
# - database 模式：首次启动时会自动迁移到数据库，之后从数据库读取
AUTH_JWT_SECRET=PLEASE_GENERATE_A_STRONG_RANDOM_SECRET_KEY_HERE

# JWT Token 有效期（小时）[可选修改]
# 建议值：1-24 小时，根据安全需求调整
AUTH_TOKEN_EXPIRY=24

# 是否启用刷新令牌（记住密码功能）[可选修改]
REFRESH_TOKEN_ENABLED=true

# 刷新令牌存储类型 [可选修改]
# 可选值: database（数据库存储，推荐）, file（文件存储）
# 默认: database
# - database: 存储在 MySQL 数据库中，支持分布式部署，性能更好
# - file: 存储在加密文件中，适合单机部署
REFRESH_TOKEN_STORAGE=database

# 刷新令牌有效期（小时）[可选修改]
# 默认 720 小时（30 天），建议不超过 90 天
REFRESH_TOKEN_TTL=720

# 刷新令牌存储路径 [可选修改]
# 仅在 REFRESH_TOKEN_STORAGE=file 时使用
# Docker 环境使用绝对路径，本地开发可使用相对路径
REFRESH_TOKEN_STORE_PATH=./cache/refresh_tokens.dat

# 刷新令牌加密密钥 [必须修改]
# 要求：必须是 32 字节（44 个 base64 字符）
# 生成方式: openssl rand -base64 32
# ⚠️  密钥泄露将导致所有刷新令牌可被解密
# 注意：database 模式下此密钥用于客户端传输加密，file 模式下用于文件加密
REFRESH_TOKEN_ENCRYPT_KEY=PLEASE_GENERATE_A_32_BYTE_ENCRYPTION_KEY

# ===========================================
# Redis 缓存配置
# ===========================================
# Redis 主机地址 [可选修改]
# - Docker Compose 环境: redis（服务名）
# - 本地开发环境: localhost
# - 生产环境: 实际 Redis 地址（建议使用内网地址）
REDIS_HOST=redis

# Redis 端口 [可选修改]
# 默认 6379，生产环境建议修改为非标准端口
REDIS_PORT=6379

# Redis 密码 [生产环境必须修改]
# 留空表示无密码（仅适用于开发环境）
# 生产环境必须设置强密码
# 生成方式: openssl rand -base64 24
REDIS_PASSWORD=

# Redis 数据库编号 [可选修改]
# 默认使用 DB 0，可选值 0-15
REDIS_DB=0

# Redis 缓存过期时间（秒）[可选修改]
# 默认 3600 秒（1 小时）
# 根据业务需求调整，建议 1800-7200 秒
REDIS_TTL=3600

# ===========================================
# 异步插件配置
# ===========================================
# 是否启用异步插件 [推荐启用]
ASYNC_PLUGIN_ENABLED=true

# 异步响应超时时间（秒）[可选修改]
ASYNC_RESPONSE_TIMEOUT=4

# 后台工作线程数 [可选修改]
# 建议值：CPU 核心数 * 2，避免过高导致资源耗尽
ASYNC_MAX_BACKGROUND_WORKERS=20

# 后台任务队列最大长度 [可选修改]
ASYNC_MAX_BACKGROUND_TASKS=100

# 异步缓存过期时间（小时）[可选修改]
ASYNC_CACHE_TTL_HOURS=1

# 是否启用异步日志 [可选修改]
ASYNC_LOG_ENABLED=true

# ===========================================
# 插件配置
# ===========================================
# 插件请求超时时间（秒）[可选修改]
PLUGIN_TIMEOUT=30

# 自定义插件配置文件路径 [可选修改]
# - 本地开发环境（backend 目录启动）建议: ./custom_plugins.json
# - Docker Compose 环境建议: /app/data/custom_plugins.json
CUSTOM_PLUGINS_PATH=./custom_plugins.json

# 支持的云盘类型 [可选修改]
CHANNELS=SharePanBaidu,tianyifc,yunpanxunlei,BaiduCloudDisk,shareAliyun,Aliyun_4K_Movies,ali_yppan,bdbdndn11,yunpanx,yp123pan,bsbdbfjfjff,txtyzy,peccxinpd,gotopan,PanjClub,baicaoZY,MCPH01,MCPH02,MCPH03,bdwpzhpd,ysxb48,jdjdn1111,yggpan,MCPH086,zaihuayun,Q66Share,ucwpzy,Quark_Movies,XiangxiuNBB,ydypzyfx,ucquark,xx123pan,yingshifenxiang123,zyfb123,tyypzhpd,tianyirigeng,cloudtianyi,hdhhd21,Lsp115,oneonefivewpfx,qixingzhenren,taoxgzy,Channel_Shares_115,tyysypzypd,vip115hot,wp123zy,yunpan139,yunpan189,yunpanuc,yydf_hzl,leoziyuan,Q_dongman,yoyokuakeduanju,TG654TG,QukanMovie,yeqingjie_GJG666,movielover8888_film3,Baidu_netdisk,D_wusun,FLMdongtianfudi,KaiPanshare,QQZYDAPP,rjyxfx,PikPak_Share_Channel,btzhi,newproductsourcing,duan_ju,QuarkFree,yunpanNB,kkdj001,xxzlzn,pxyunpanxunlei,jxwpzy,kuakedongman,xiangnikanj,solidsexydoll,guoman4K,zdqxm,kduanju,cilidianying,CBduanju,SharePanFilms,dzsgx,BooksRealm,Oscar_4Kmovies,douerpan,baidu_yppan,Q_jilupian,Netdisk_Movies,yunpanquark,ciliziyuanku

# 启用的插件列表 [可选修改]
# 根据实际需求启用插件，减少不必要的资源消耗
ENABLED_PLUGINS=labi,shandian,muou,wanou,hunhepan,pansearch,panta,susu,thepiratebay,xuexizhinan,ouge,erxiao,fox4k,clmao,cldi,libvio,yuhuage,u3c3,javdb,jutoushe,djgou,nyaa,xinjuc,aikanzy,quark4k,quarksoo,ash

# 插件总数 [自动计算]
PLUGIN_COUNT=27

# ===========================================
# HTTP 服务器配置
# ===========================================
# 读取超时时间（秒）[可选修改]
HTTP_READ_TIMEOUT=90

# 写入超时时间（秒）[可选修改]
HTTP_WRITE_TIMEOUT=90

# 空闲超时时间（秒）[可选修改]
HTTP_IDLE_TIMEOUT=120

# 最大并发连接数 [可选修改]
# 建议值：500-2000，根据服务器性能调整
# ⚠️  过高可能导致资源耗尽，建议配合限流使用
HTTP_MAX_CONNS=2000

# ===========================================
# 性能优化配置
# ===========================================
# Go GC 触发百分比 [可选修改]
# 默认 100，增大可减少 GC 频率但增加内存占用
GC_PERCENT=100

# 是否启用内存优化 [推荐启用]
OPTIMIZE_MEMORY=true

# 是否启用响应压缩 [可选修改]
# 启用后可减少带宽消耗，但增加 CPU 负载
ENABLE_COMPRESSION=false

# 压缩最小文件大小（字节）[可选修改]
MIN_SIZE_TO_COMPRESS=1024

# 并发搜索数 [可选修改]
# 建议值：20-100，根据插件数量和服务器性能调整
CONCURRENCY=50

# ===========================================
# 运维部署配置 (生产环境专用)
# ===========================================

# 域名配置 [必须修改]
DOMAIN=example.com
WWW_DOMAIN=www.example.com

# Docker 镜像配置 [必须修改]
DOCKER_USERNAME=your_username
IMAGE_NAME=unisearch
VERSION=1.0.0
FULL_IMAGE_NAME=your_username/unisearch:1.0.0

# Nginx 端口配置 [可选修改]
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
FRONTEND_PORT=3000
BACKEND_PORT=8888

# SSL 证书配置 [必须修改]
# 使用 Let's Encrypt 自动生成证书时会自动填充
SSL_CERT_PATH=/etc/letsencrypt/live/${DOMAIN}/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/${DOMAIN}/privkey.pem
SSL_EMAIL=admin@example.com

# 监控与日志 [可选修改]
ENABLE_MONITORING=true
ENABLE_LOG_COLLECTION=true

# Watchtower 自动更新令牌 [必须修改]
# 生成方式: openssl rand -hex 32
WATCHTOWER_TOKEN=PLEASE_GENERATE_A_RANDOM_TOKEN

# 备份配置 [可选修改]
BACKUP_PATH=/opt/unisearch/backup
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"

# 防火墙配置 [推荐启用]
UFW_ENABLED=true
UFW_ALLOW_PORTS=22,80,443

# 部署元数据 [可选修改]
DEPLOY_ENV=production
DEPLOY_VERSION=1.0.0

# ===========================================
# 配置验证检查清单
# ===========================================
# 部署前请确认以下配置项已修改：
# [ ] DB_PASSWORD - 数据库密码
# [ ] AUTH_JWT_SECRET - JWT 签名密钥
# [ ] SECRET_MASTER_KEY - 主密钥（database 模式必需）
# [ ] REFRESH_TOKEN_ENCRYPT_KEY - 刷新令牌加密密钥（32字节）
# [ ] DOMAIN - 域名
# [ ] SSL_EMAIL - SSL 证书邮箱
# [ ] WATCHTOWER_TOKEN - 自动更新令牌
# [ ] DOCKER_USERNAME - Docker 用户名
# [ ] REDIS_PASSWORD - Redis 密码（生产环境必需）
#
# 可选但推荐修改：
# [ ] DB_USER - 使用专用数据库用户而非 root
# [ ] DB_PORT - 修改为非标准端口
# [ ] PORT - 应用监听端口
# [ ] SECRET_BACKEND - 选择密钥存储后端（推荐 database）
# [ ] REDIS_HOST - Redis 主机地址
# [ ] REDIS_PORT - Redis 端口（生产环境建议修改）
