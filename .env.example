# ===========================================
# UniSearch 环境变量配置文件
# ===========================================
# 
# 【重要安全提示】
# ⚠️  本文件仅作为配置模板，切勿直接用于生产环境！
# ⚠️  所有标记为 [必须修改] 的配置项必须在生产环境中更改
# ⚠️  建议使用密钥管理服务（如 Vault、AWS Secrets Manager）管理敏感信息
#
# 【使用说明】
# 1. 本地开发环境：
#    - 复制此文件为 .env
#    - DB_HOST 设置为 localhost
#    - 启动脚本 scripts/local.sh 会自动加载 .env 文件
#
# 2. Docker Compose 环境：
#    - 复制此文件为 .env
#    - DB_HOST 设置为 mysql（服务名）
#    - docker-compose.yml 会自动加载 .env 文件
#
# 3. 生产环境部署：
#    - 参考"运维部署配置"章节
#    - 使用命令生成强随机密钥：openssl rand -base64 32
#    - 建议使用环境变量注入而非 .env 文件
#
# ===========================================
# 基础业务配置
# ===========================================
TZ=Asia/Shanghai

# 应用监听端口 [可选修改]
# 建议生产环境使用反向代理，应用监听非标准端口
PORT=8888

# ===========================================
# 数据库配置 (MySQL) - 必需配置
# ===========================================
# 数据库主机地址 [必须修改]
# - Docker Compose 环境: mysql
# - 本地开发环境: localhost
# - 生产环境: 实际数据库地址（建议使用内网地址）
DB_HOST=localhost

# 数据库端口 [可选修改]
# 生产环境建议修改为非标准端口
DB_PORT=3306

# 数据库用户名 [必须修改]
# 生产环境禁止使用 root 用户，应创建专用数据库用户
DB_USER=unisearch_app

# 数据库密码 [必须修改]
# 要求：至少 16 字符，包含大小写字母、数字和特殊字符
# 生成方式: openssl rand -base64 24
DB_PASSWORD=PLEASE_CHANGE_THIS_PASSWORD

# 数据库名称 [可选修改]
# 系统启动时会自动创建
DB_NAME=unisearch

# ===========================================
# 认证与安全配置 [生产环境必须修改]
# ===========================================
# 运行环境 [生产环境必须设置为 production]
# 可选值: development, test, production
APP_ENV=development

# CORS 允许来源 [生产环境必须修改]
# 多个来源用英文逗号分隔；生产环境禁止使用 *
ALLOWED_ORIGINS=https://example.com

# 首次初始化管理员 [生产环境必须修改]
# 生产环境不会自动创建 admin/admin，必须显式提供初始管理员账号和强密码
INITIAL_ADMIN_USERNAME=PLEASE_SET_INITIAL_ADMIN_USERNAME
INITIAL_ADMIN_PASSWORD=PLEASE_SET_INITIAL_ADMIN_STRONG_PASSWORD

# 是否启用 API Key 认证 [推荐启用]
API_KEY_ENABLED=true

# ===========================================
# 密钥管理配置
# ===========================================
# 密钥存储后端类型 [可选修改]
# 可选值: database（数据库存储，默认推荐）, environment（环境变量）
# 默认: database
# - database: 密钥加密存储在数据库中，支持密钥轮换和版本管理（推荐生产环境）
# - environment: 从环境变量读取密钥（向后兼容，适合简单部署）
SECRET_BACKEND=database

# 主密钥（用于加密数据库中的密钥）[必须修改]
# 在 SECRET_BACKEND=database 时必需
# 要求：至少 32 字节的强随机字符串
# 生成方式: openssl rand -base64 32
# ⚠️  主密钥泄露将导致所有存储的密钥可被解密
# 注意：主密钥本身不存储在数据库中，只存储在环境变量中
SECRET_MASTER_KEY=PLEASE_GENERATE_A_STRONG_MASTER_KEY_HERE

# JWT 签名密钥 [必须修改]
# 要求：至少 32 字节的强随机字符串
# 生成方式: openssl rand -base64 32
# ⚠️  密钥泄露将导致所有 Token 可被伪造
# 注意：
# - environment 模式：直接使用此环境变量
# - database 模式：首次启动时会自动迁移到数据库，之后从数据库读取
AUTH_JWT_SECRET=PLEASE_GENERATE_A_STRONG_RANDOM_SECRET_KEY_HERE

# JWT Token 有效期（小时）[可选修改]
# 建议值：1-24 小时，根据安全需求调整
AUTH_TOKEN_EXPIRY=24

# 用户名与密码长度策略 [可选修改]
# 前端注册页会读取公开系统设置中的这组策略，后端仍然是最终校验来源
# 新设置的账号密码不能包含空格、Tab、换行等空白字符
AUTH_USERNAME_MIN_LENGTH=3
AUTH_USERNAME_MAX_LENGTH=32
AUTH_PASSWORD_MIN_LENGTH=6
AUTH_PASSWORD_MAX_LENGTH=64

# 是否启用刷新令牌（记住密码功能）[可选修改]
REFRESH_TOKEN_ENABLED=true

# 刷新令牌存储类型 [可选修改]
# 可选值: database（数据库存储，推荐）, file（文件存储）
# 默认: database
# - database: 存储在 MySQL 数据库中，支持分布式部署，性能更好
# - file: 存储在加密文件中，适合单机部署
REFRESH_TOKEN_STORAGE=database

# 刷新令牌有效期（小时）[可选修改]
# 默认 720 小时（30 天），建议不超过 90 天
REFRESH_TOKEN_TTL=720

# 刷新令牌存储路径 [可选修改]
# 仅在 REFRESH_TOKEN_STORAGE=file 时使用
# Docker 环境使用绝对路径，本地开发可使用相对路径
REFRESH_TOKEN_STORE_PATH=./cache/refresh_tokens.dat

# 刷新令牌加密密钥 [必须修改]
# 要求：必须是 32 字节（44 个 base64 字符）
# 生成方式: openssl rand -base64 32
# ⚠️  密钥泄露将导致所有刷新令牌可被解密
# 注意：database 模式下此密钥用于客户端传输加密，file 模式下用于文件加密
REFRESH_TOKEN_ENCRYPT_KEY=PLEASE_GENERATE_A_32_BYTE_ENCRYPTION_KEY

# ===========================================
# Redis 缓存配置
# ===========================================
# Redis 主机地址 [可选修改]
# - Docker Compose 环境: redis（服务名）
# - 本地开发环境: localhost
# - 生产环境: 实际 Redis 地址（建议使用内网地址）
REDIS_HOST=redis

# Redis 端口 [可选修改]
# 默认 6379，生产环境建议修改为非标准端口
REDIS_PORT=6379

# Redis 密码 [生产环境必须修改]
# 本地开发如使用无密码 Redis，可复制后自行置空；生产环境必须设置强密码
# 生成方式: openssl rand -base64 24
REDIS_PASSWORD=PLEASE_SET_STRONG_REDIS_PASSWORD

# Redis 数据库编号 [可选修改]
# 默认使用 DB 0，可选值 0-15
REDIS_DB=0

# Redis 缓存过期时间（秒）[可选修改]
# 默认 3600 秒（1 小时）
# 根据业务需求调整，建议 1800-7200 秒
# 说明：该值现在主要用于首次初始化后台缓存配置时写入默认搜索缓存 TTL
REDIS_TTL=3600

# ===========================================
# TMDB 热门内容页配置
# ===========================================
# 正常推荐配置：TMDB Read Access Token（推荐）
# 获取位置：TMDB -> Settings -> API -> API Read Access Token
# 说明：/hot 页面正常使用时优先配置该字段，并将 TMDB_API_KEY 留空
TMDB_READ_ACCESS_TOKEN=

# 兼容配置：TMDB API Key（v3，可选）
# 获取位置：TMDB -> Settings -> API -> API Key
# 说明：如果没有 Read Access Token，可以只配置这个字段
# 如果已经配置了 TMDB_READ_ACCESS_TOKEN，建议将这里留空，避免混淆
TMDB_API_KEY=

# TMDB API 基础地址
TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB 默认语言与区域
TMDB_DEFAULT_LANGUAGE=zh-CN
TMDB_DEFAULT_REGION=CN

# TMDB 图片基础地址
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# TMDB 请求超时时间
TMDB_REQUEST_TIMEOUT=8s

# 热门榜单预热配置
# 启动后会先预热一次，随后每天按北京时间固定时刻刷新到 Redis
# 说明：这些值在首次初始化后台缓存配置时会写入 `system_settings`
# 后续推荐直接在后台“系统设置 -> 缓存配置”中调整
HOT_RANKING_PRELOAD_ENABLED=true
HOT_RANKING_PRELOAD_TIME=00:00
HOT_RANKING_PRELOAD_TIMEOUT=30s
HOT_RANKING_PRELOAD_CONCURRENCY=2

# 热门榜单缓存 TTL
# 说明：后台统一使用 24 小时 TTL，这里主要作为首次初始化默认值来源
HOT_RANKING_CACHE_TTL_DAY=24h
HOT_RANKING_CACHE_TTL_WEEK=24h
HOT_RANKING_CACHE_TTL_MONTH=24h
HOT_RANKING_CACHE_TTL_YEAR=24h

# ===========================================
# 异步插件配置
# ===========================================
# 是否启用异步插件 [推荐启用]
ASYNC_PLUGIN_ENABLED=true

# 异步响应超时时间（秒）[可选修改]
ASYNC_RESPONSE_TIMEOUT=4

# 后台工作线程数 [可选修改]
# 建议值：CPU 核心数 * 2，避免过高导致资源耗尽
ASYNC_MAX_BACKGROUND_WORKERS=20

# 后台任务队列最大长度 [可选修改]
ASYNC_MAX_BACKGROUND_TASKS=100

# 异步缓存过期时间（小时）[可选修改]
ASYNC_CACHE_TTL_HOURS=1

# 是否启用异步日志 [可选修改]
ASYNC_LOG_ENABLED=true

# ===========================================
# 插件配置
# ===========================================
# 插件请求超时时间（秒）[可选修改]
PLUGIN_TIMEOUT=30

# 初始化 Telegram 频道兜底列表 [可选修改]
# 用途：
# 1. 首次启动时补齐数据库中缺失的频道
# 2. 数据库暂无启用频道时，作为搜索默认频道兜底
CHANNELS=SharePanBaidu,tianyifc,yunpanxunlei,BaiduCloudDisk,shareAliyun,Aliyun_4K_Movies,ali_yppan,bdbdndn11,yunpanx,yp123pan,bsbdbfjfjff,txtyzy,peccxinpd,gotopan,PanjClub,baicaoZY,MCPH01,MCPH02,MCPH03,bdwpzhpd,ysxb48,jdjdn1111,MCPH086,zaihuayun,Q66Share,ucwpzy,Quark_Movies,XiangxiuNBB,ydypzyfx,ucquark,xx123pan,yingshifenxiang123,zyfb123,tyypzhpd,tianyirigeng,cloudtianyi,hdhhd21,Lsp115,oneonefivewpfx,taoxgzy,Channel_Shares_115,vip115hot,wp123zy,yunpan139,yunpan189,yunpanuc,yydf_hzl,leoziyuan,Q_dongman,yoyokuakeduanju,TG654TG,QukanMovie,yeqingjie_GJG666,movielover8888_film3,Baidu_netdisk,D_wusun,FLMdongtianfudi,QQZYDAPP,rjyxfx,PikPak_Share_Channel,btzhi,newproductsourcing,duan_ju,QuarkFree,yunpanNB,kkdj001,xxzlzn,pxyunpanxunlei,jxwpzy,kuakedongman,xiangnikanj,solidsexydoll,guoman4K,zdqxm,kduanju,cilidianying,CBduanju,SharePanFilms,dzsgx,BooksRealm,Oscar_4Kmovies,douerpan,baidu_yppan,Q_jilupian,Netdisk_Movies,yunpanquark,ciliziyuanku,tgbokee,gokuapan,gimy115,WFYSFX03,Q_dianying,domgmingapk,dianying4k,q_dianshiju,ucshare,godupan,gimy100,gimy115iso

# 启动注册默认插件清单 [可选修改]
# 用途：
# 1. 限制启动时注册哪些源码内置插件
# 2. 作为默认清单和临时覆盖项，长期启停状态仍以后台/数据库为准
ENABLED_PLUGINS=labi,shandian,muou,wanou,hunhepan,pansearch,panta,susu,thepiratebay,ouge,erxiao,clmao,u3c3,javdb,jutoushe,nyaa,xinjuc,aikanzy,quark4k,quarksoo,huban,panwiki,panyq,sidhub

# ===========================================
# HTTP 服务器配置
# ===========================================
# 读取超时时间（秒）[可选修改]
HTTP_READ_TIMEOUT=90

# 写入超时时间（秒）[可选修改]
HTTP_WRITE_TIMEOUT=90

# 空闲超时时间（秒）[可选修改]
HTTP_IDLE_TIMEOUT=120

# 最大并发连接数 [可选修改]
# 建议值：500-2000，根据服务器性能调整
# ⚠️  过高可能导致资源耗尽，建议配合限流使用
HTTP_MAX_CONNS=2000

# ===========================================
# 性能优化配置
# ===========================================
# Go GC 触发百分比 [可选修改]
# 默认 100，增大可减少 GC 频率但增加内存占用
GC_PERCENT=100

# 是否启用内存优化 [推荐启用]
OPTIMIZE_MEMORY=true

# 是否启用响应压缩 [可选修改]
# 启用后可减少带宽消耗，但增加 CPU 负载
ENABLE_COMPRESSION=false

# 压缩最小文件大小（字节）[可选修改]
MIN_SIZE_TO_COMPRESS=1024

# 并发搜索数 [可选修改]
# 建议值：20-100，根据插件数量和服务器性能调整
CONCURRENCY=50

# ===========================================
# 搜索链路调优 [可选，默认值已适用，取消注释以覆盖]
# ===========================================
# 插件状态缓存 TTL（秒），默认 30
#PLUGIN_STATE_CACHE_TTL_SECONDS=30
# 搜索缓存异步写队列长度，默认 256
#CACHE_WRITE_QUEUE_SIZE=256
# 搜索缓存异步写 worker 数，默认 4
#CACHE_WRITE_WORKERS=4
# 常态搜索事件日志（排障时临时开启），默认 false
#SEARCH_EVENT_LOG_ENABLED=false

# ===========================================
# 网络代理 [可选]
# ===========================================
# 统一代理（设置后自动启用），如 socks5://127.0.0.1:1080 或 http://127.0.0.1:7890
#PROXY=
# 或分别设置 HTTP/HTTPS 代理
#HTTP_PROXY=
#HTTPS_PROXY=

# ===========================================
# 前端公开配置 [可选]
# ===========================================
VITE_PUBLIC_SITE_URL=https://example.com/
VITE_DEFAULT_COPY_FORMAT_TEMPLATE=卡密：{key}，网址：https://example.com/

# ===========================================
# 运维脚本专用配置
# ===========================================
# 与 build.sh / deploy-update.sh / backup-manager.sh / gen-production-secrets.sh
# 相关的部署变量已迁移到 `deploy/.env.operations.example`。

# ===========================================
# 配置验证检查清单
# ===========================================
# 如果本地或测试环境曾经使用过模板中的占位密钥、默认数据库凭据或 TMDB token，
# 上线前必须重新生成并轮换，避免把已暴露配置带入生产环境。
# 部署前请确认以下配置项已修改：
# [ ] DB_PASSWORD - 数据库密码
# [ ] ALLOWED_ORIGINS - 生产前端和管理端域名
# [ ] AUTH_JWT_SECRET - JWT 签名密钥
# [ ] SECRET_MASTER_KEY - 主密钥（database 模式必需）
# [ ] REFRESH_TOKEN_ENCRYPT_KEY - 刷新令牌加密密钥（32字节）
# [ ] REDIS_PASSWORD - Redis 密码（生产环境必需）
#
# 可选但推荐修改：
# [ ] DB_USER - 使用专用数据库用户而非 root
# [ ] DB_PORT - 修改为非标准端口
# [ ] SECRET_BACKEND - 选择密钥存储后端（推荐 database）
# [ ] REDIS_HOST - Redis 主机地址
# [ ] REDIS_PORT - Redis 端口（生产环境建议修改）
