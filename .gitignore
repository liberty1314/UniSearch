# ===================================================================
# UniSearch .gitignore  (Go backend + React/TS frontend)
# 按区块组织：OS / 编辑器与工具 / Node / Go / 环境变量与密钥 /
#            数据库与备份 / 日志与运行时 / 缓存与临时 / Docker 与部署
# ===================================================================

# ----- OS generated files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----- 编辑器 / IDE / AI 工具 -----
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/
.cursor/
.kiro/
.clouder/
.agent/
.Codex/
.od-skills/
.remember/
.superpowers/
docs/superpowers/
.codegraph/
.promptx/
.trae/
.shared/
.playwright-mcp/
.impeccable/
.vercel/
testsprite_tests/
# ----- 临时文件 -----
resource-detail-redesign*
critique.json

# ----- Node / 前端 -----
node_modules/
.pnpm-store/
*-debug.log*
pnpm-debug.log*
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo
*.tgz
dist/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# ----- Go / 后端编译产物 -----
backend/unisearch
backend/backend
backend/*.exe
backend/*.test
backend/*.out
backend/refresh_tokens.dat

# ----- 环境变量与密钥（敏感信息，勿提交）-----
.env
.env.*
!.env.example
.config_updated
api_keys.json
*.pem
*.key
*.crt
*.p12
*.pfx

# ----- 数据库与备份 -----
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
backup-*.sql
backups/
*.bak
*.backup
*.old

# ----- 日志与运行时数据 -----
logs/
*.log
pids
*.pid
*.seed
*.pid.lock

# ----- 缓存与临时目录 -----
.cache/
.parcel-cache
tmp/
temp/
.worktrees/
.venv

# ----- Docker / 部署 -----
.docker/
.dockerignore
Dockerfile.prod
Dockerfile.*.cn
Dockerfile.test
Dockerfile.local
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml
!docker-compose.prod.yml
docker/mysql/data/
docker/redis/data/
unisearch:*
!unisearch:latest
.railway/
railway.toml
railway.json

# ----- 临时调试 / 一次性脚本（勿提交）-----
scratch/
/test_urls.py
/sidhub-search-response-*.json
