# ============================================================
# 微信 OAuth 登录功能环境变量配置示例
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env（或追加到现有的 .env 文件）
# 2. 填写实际的配置值
# 3. 确保 .env 文件已添加到 .gitignore，不要提交到版本控制

# ============================================================
# 微信开放平台配置（必需）
# ============================================================
# 微信应用 ID（从微信开放平台获取）
WECHAT_APP_ID=your_wechat_app_id

# 微信应用密钥（从微信开放平台获取，请妥善保管）
WECHAT_APP_SECRET=your_wechat_app_secret

# 授权回调地址（必须与微信开放平台配置的回调域名一致）
# 格式：https://yourdomain.com/api/oauth/wechat/callback
WECHAT_CALLBACK_URL=https://yourdomain.com/api/oauth/wechat/callback

# ============================================================
# OAuth 配置（可选）
# ============================================================
# 授权范围：snsapi_base（静默授权）或 snsapi_userinfo（获取用户信息）
# 默认：snsapi_userinfo
WECHAT_SCOPE=snsapi_userinfo

# State 参数有效期（秒），用于防止 CSRF 攻击
# 默认：600（10 分钟）
WECHAT_STATE_TTL=600

# 是否启用微信登录功能
# 默认：true
WECHAT_ENABLED=true

# ============================================================
# 会话配置（可选）
# ============================================================
# 会话有效期（秒）
# 默认：604800（7 天）
WECHAT_SESSION_TTL=604800

# 会话 Cookie 名称
# 默认：wechat_session_token
WECHAT_SESSION_COOKIE_NAME=wechat_session_token

# ============================================================
# 限流配置（可选）
# ============================================================
# IP 每小时登录限制
# 默认：100
WECHAT_RATE_LIMIT_IP_HOURLY=100

# 用户每小时登录限制
# 默认：20
WECHAT_RATE_LIMIT_USER_HOURLY=20

# 全局每秒登录限制
# 默认：1000
WECHAT_RATE_LIMIT_GLOBAL_PER_SECOND=1000

# ============================================================
# 降级配置（可选）
# ============================================================
# 连续失败次数阈值，达到后触发服务降级
# 默认：3
WECHAT_DEGRADATION_FAILURE_THRESHOLD=3

# 降级持续时间（秒）
# 默认：600（10 分钟）
WECHAT_DEGRADATION_TTL=600

# 恢复检测间隔（秒）
# 默认：300（5 分钟）
WECHAT_DEGRADATION_CHECK_INTERVAL=300

# ============================================================
# HTTP 配置（可选）
# ============================================================
# HTTP 请求超时（秒）
# 默认：10
WECHAT_HTTP_TIMEOUT=10

# 最大重试次数
# 默认：3
WECHAT_HTTP_MAX_RETRIES=3

# ============================================================
# 加密配置（必需）
# ============================================================
# AES 加密密钥（32 字节），用于加密存储 OAuth 令牌
# 生成方法：openssl rand -hex 32
# 警告：请妥善保管此密钥，泄露将导致令牌被解密
WECHAT_AES_KEY=<API_KEY>

# ============================================================
# 数据库配置（必需，如果已配置则无需重复）
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=unisearch

# ============================================================
# 站内账户认证策略（可选）
# ============================================================
# 如果启用了站内注册/登录，可通过以下配置统一用户名与密码长度规则。
# 前端注册页会读取公开系统设置中的这组值，后端仍然负责最终校验。
AUTH_USERNAME_MIN_LENGTH=3
AUTH_USERNAME_MAX_LENGTH=32
AUTH_PASSWORD_MIN_LENGTH=6
AUTH_PASSWORD_MAX_LENGTH=64

# ============================================================
# Redis 配置（必需，如果已配置则无需重复）
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ============================================================
# TMDB 热门榜单配置（热门内容页必需）
# ============================================================
# 推荐配置：TMDB 读取令牌（Read Access Token）
# 获取位置：TMDB -> Settings -> API -> API Read Access Token
# 正常使用时优先配置该字段，并将 TMDB_API_KEY 留空
TMDB_READ_ACCESS_TOKEN=

# 兼容配置：TMDB API Key（v3，可选）
# 仅在你没有 Read Access Token 时再使用该字段
# 如果配置了 TMDB_READ_ACCESS_TOKEN，建议将这里留空，避免混淆
TMDB_API_KEY=

# TMDB API 基础地址
TMDB_BASE_URL=https://api.themoviedb.org/3

# 默认语言与地区
TMDB_DEFAULT_LANGUAGE=zh-CN
TMDB_DEFAULT_REGION=CN

# 图片基础地址
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# TMDB 请求超时时间
TMDB_REQUEST_TIMEOUT=8s

# 热门榜单预热配置
# 启动后会先预热一次，随后每天按北京时间固定时刻刷新到 Redis
HOT_RANKING_PRELOAD_ENABLED=true
HOT_RANKING_PRELOAD_TIME=10:00
HOT_RANKING_PRELOAD_TIMEOUT=30s
HOT_RANKING_PRELOAD_CONCURRENCY=2

# 热门榜单缓存时间
# 日榜建议较短，周榜适中，月榜和年榜更长
HOT_RANKING_CACHE_TTL_DAY=30m
HOT_RANKING_CACHE_TTL_WEEK=2h
HOT_RANKING_CACHE_TTL_MONTH=6h
HOT_RANKING_CACHE_TTL_YEAR=12h

# ============================================================
# 内置插件配置
# ============================================================
# 52API 网盘搜索请求密钥；启用 52API 内置插件时必填。
PLUGIN_52API_KEY=
